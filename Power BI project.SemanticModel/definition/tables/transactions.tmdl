table transactions
	lineageTag: 7778c103-be14-4b83-b09c-2906f415c96f

	measure 'Retention %' = ```
			
			VAR CohortSize = 
			    CALCULATE(
			        DISTINCTCOUNT(transactions[user_id]),
			        ALL(transactions[MonthsSinceFirst])
			    )
			RETURN DIVIDE(DISTINCTCOUNT(transactions[user_id]), CohortSize)
			```
		lineageTag: 0ff75e90-d122-4b8f-850a-220d37bd0998

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Velocity Flagged Users' =
			
			CALCULATE(
			    DISTINCTCOUNT(transactions[user_id]),
			    transactions[FlagVelocity] = 1
			)
		formatString: 0
		lineageTag: c3ccec06-97da-4437-b225-4cdd7ac78dee

	measure 'User Max Fraud Score' = MAX(transactions[FraudScore])
		formatString: 0
		lineageTag: 162b4652-c9c8-4b68-8342-23ef5ea1cfc0

	measure 'Users Score 3' =
			
			CALCULATE(
			    DISTINCTCOUNT(transactions[user_id]),
			    FILTER(
			        VALUES(transactions[user_id]),
			        CALCULATE(MAX(transactions[FraudScore])) >= 3
			    )
			)
		formatString: 0
		lineageTag: 60a63097-8695-43c1-b43a-f30b4ce7a501

	measure 'Is Flagged User' =
			
			IF(CALCULATE(MAX(transactions[FraudScore])) >= 2, 1, 0)
		formatString: 0
		lineageTag: 59bd5fba-dd5d-48b9-9b1e-c1fbf85e1027

	measure 'True Positives' =
			
			CALCULATE(
			    DISTINCTCOUNT(transactions[user_id]),
			    FILTER(
			        VALUES(transactions[user_id]),
			        CALCULATE(MAX(transactions[FraudScore])) >= 2
			            && transactions[user_id] IN VALUES(fraud_labels[user_id])
			    )
			)
		lineageTag: 5bc4be1b-cdef-4157-89ae-c0fad88079f0

	measure Recall = DIVIDE([True Positives], COUNTROWS(fraud_labels))
		lineageTag: 4dc3c164-7f17-45b2-84bb-a8979b749186

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Precision = DIVIDE([True Positives], [Users Score 2plus])
		lineageTag: ddf6aa65-2922-421f-a087-6310a12aabc0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

