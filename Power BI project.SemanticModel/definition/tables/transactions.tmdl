	column TxnDate = DATEVALUE(transactions[timestamp])
		formatString: General Date
		lineageTag: d81e061c-68c1-4b73-8134-f7a1d136470f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CohortMonth = ```
			
			VAR FirstTxn = 
			    CALCULATE(
			        MIN(transactions[TxnDate]),
			        ALLEXCEPT(transactions, transactions[user_id])
			    )
			RETURN EOMONTH(FirstTxn, -1) + 1
			```
		formatString: General Date
		lineageTag: 4ecbcd93-0994-496a-a1f4-c6ca1b2c544a
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 0aa36496-43aa-4e78-822e-871b4080e2ef
			defaultHierarchy: LocalDateTable_795d0f03-855d-46ea-aed1-72fba89ac2ee.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column MonthsSinceFirst =
			
			DATEDIFF(
			    transactions[CohortMonth],
			    EOMONTH(transactions[TxnDate], -1) + 1,
			    MONTH
			)
		formatString: 0
		lineageTag: 66979f83-cd77-4759-9739-9fccfa359ed3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CohortLabel = FORMAT(transactions[CohortMonth], "YYYY-MM")
		lineageTag: 97a31bc6-9073-46ad-9709-93705b1f15b8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column UserHour = transactions[user_id] & "|" & FORMAT(transactions[timestamp], "YYYY-MM-DD HH")
		lineageTag: d9831674-ae62-4701-abde-b83362b8d7c7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TxnsInThisHour =
			
			CALCULATE(
			    COUNTROWS(transactions),
			    ALLEXCEPT(transactions, transactions[UserHour])
			)
		formatString: 0
		lineageTag: 5da60b54-9c5e-47a4-a908-358fd0345618
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FlagVelocity = IF(transactions[TxnsInThisHour] >= 6, 1, 0)
		formatString: 0
		lineageTag: 328a15ca-1e4d-4b17-9fcc-9975b0e99e2a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FlagStructuring = ```
			
			VAR Amt = transactions[amount]
			VAR NearThreshold = 
			    (Amt >= 9200 && Amt < 10000) ||
			    (Amt >= 24200 && Amt < 25000) ||
			    (Amt >= 49200 && Amt < 50000) ||
			    (Amt >= 99200 && Amt < 100000)
			RETURN IF(NearThreshold, 1, 0)
			```
		formatString: 0
		lineageTag: 77a437e1-6ab4-46ee-873e-4d1a1956aed7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FlagOddHour =
			
			VAR Hr = HOUR(transactions[timestamp])
			RETURN IF(Hr >= 1 && Hr <= 5, 1, 0)
		formatString: 0
		lineageTag: 3eb12b21-4410-4bd6-a857-a9545d5ee6eb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FraudScore = ```
			
			transactions[FlagVelocity] + 
			transactions[FlagStructuring] + 
			transactions[FlagOddHour]
			```
		formatString: 0
		lineageTag: e9e7f73d-8099-4d2a-974d-d538e5668f8f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

